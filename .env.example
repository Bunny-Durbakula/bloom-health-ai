# Bloom Health AI Environment Variables Example
# Copy to .env or set these in your local environment.
# DO NOT commit real secrets or credentials to source control.

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/bloom_health
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
